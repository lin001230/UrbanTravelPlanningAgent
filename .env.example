# Copy to .env for docker run --env-file .env; Spring Boot does not load this file itself.
# Do not put real credentials in this example file.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_BASE_URL=replace-with-the-same-dashscope-base-url-used-locally
TENCENT_MAP_API_KEY=replace-with-your-tencent-map-webservice-key
DEEPSEEK_SEARCH_API_KEY=replace-with-your-deepseek-api-key

# Use a MySQL address reachable from the backend container, not localhost.
# Docker Desktop connecting to MySQL on this computer can use host.docker.internal.
MYSQL_HOST=replace-with-your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=urban_travel_planning_agent
MYSQL_USERNAME=replace-with-your-mysql-username
MYSQL_PASSWORD=replace-with-your-mysql-password

# Optional. Overrides the built-in token signing key. Use a long random value on cloud hosting.
JWT_SECRET=replace-with-a-long-random-secret
